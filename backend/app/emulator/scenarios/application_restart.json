{
  "schema_version": 1,
  "scenario_key": "application_restart",
  "name": "Application restart",
  "version": 1,
  "category": "reliability",
  "description": "Cold start, force-stop and cold start again, then a warm resume from background; every launch must succeed.",
  "steps": [
    {
      "action": "launch_app",
      "config": {
        "cold": true
      },
      "expect": {
        "launch_status": "ok"
      },
      "timeout_seconds": 120
    },
    {
      "action": "wait",
      "config": {
        "seconds": 5
      },
      "timeout_seconds": 120
    },
    {
      "action": "force_stop",
      "timeout_seconds": 120
    },
    {
      "action": "launch_app",
      "config": {
        "cold": true
      },
      "expect": {
        "launch_status": "ok",
        "max_duration_ms": 5000
      },
      "timeout_seconds": 120
    },
    {
      "action": "wait",
      "config": {
        "seconds": 3
      },
      "timeout_seconds": 120
    },
    {
      "action": "background_app",
      "timeout_seconds": 120
    },
    {
      "action": "relaunch",
      "config": {
        "cold": false
      },
      "expect": {
        "launch_status": "ok"
      },
      "timeout_seconds": 120
    },
    {
      "action": "assert_app_healthy",
      "expect": {
        "process_alive": true,
        "foreground": true,
        "no_crash": true,
        "no_anr": true
      },
      "timeout_seconds": 120
    },
    {
      "action": "screenshot",
      "config": {
        "label": "after_restarts"
      },
      "timeout_seconds": 120
    }
  ]
}
