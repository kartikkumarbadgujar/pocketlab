APP_NAME=PocketLab
ENVIRONMENT=development
POSTGRES_DB=pocketlab
POSTGRES_USER=pocketlab
POSTGRES_PASSWORD=replace-with-a-long-random-db-password
DATABASE_URL=postgresql+psycopg://pocketlab:replace-with-a-long-random-db-password@localhost:5432/pocketlab
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
RUNNER_TOKEN=replace-with-a-separate-long-runner-secret
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
TRUSTED_HOSTS=["localhost","127.0.0.1","testserver"]
UPLOAD_DIR=./private_uploads
MAX_APK_SIZE_BYTES=104857600
RATE_LIMIT=120/minute
LOG_LEVEL=INFO

# ---- Android execution worker (python -m app.workers.emulator_runner) --------------------------------
# The worker runs OUTSIDE the API process, on a machine with the Android SDK and hardware acceleration.
# It authenticates with RUNNER_TOKEN above. Never point it at a shared production API from a laptop.
POCKETLAB_API_URL=http://127.0.0.1:8000/api/v1
# Android SDK location. Only explicit configuration is used; nothing is guessed.
ANDROID_SDK_ROOT=
POCKETLAB_WORK_DIR=./worker_data
POCKETLAB_AGENT_NAME=pocketlab-android-worker
POCKETLAB_BOOT_TIMEOUT_S=420
POCKETLAB_STORAGE_RESERVE_MB=200
POCKETLAB_MEMORY_FLOOR_MB=200
POCKETLAB_EMULATOR_GPU=swiftshader_indirect
POCKETLAB_EMULATOR_HEADLESS=1
POCKETLAB_PROBE_HOST=1.1.1.1
# Physical devices: JSON map of PocketLab device id -> local ADB serial (serials never leave the worker).
POCKETLAB_PHYSICAL_DEVICES=
# Linux-only isolated netem gateway (packet loss, jitter distribution, DNS failure). See docs/ANDROID_WORKER.md.
POCKETLAB_NETEM_ENABLED=0
POCKETLAB_KEEP_FAILED_AVD=0
